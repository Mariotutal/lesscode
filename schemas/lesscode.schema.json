          },
          "required": [
            "provider",
            "model"
          ],
          "additionalProperties": false
        },
        "wonder": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "provider",
            "model"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "pricing": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "inputPerMtok": {
            "type": "number",
            "minimum": 0
          },
          "outputPerMtok": {
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
