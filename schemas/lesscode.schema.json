  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "providers": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "baseUrl": {
            "type": "string",
            "minLength": 1
          },
          "apiKeyEnv": {
            "type": "string",
            "minLength": 1
          },
          "apiKey": {
            "not": {}
          }
        },
        "required": [
          "baseUrl",
          "apiKeyEnv"
        ],
        "additionalProperties": false
      }
    },
    "models": {
      "type": "object",
      "properties": {
        "spark": {
          "type": "object",
