{
  "name": "lesscode",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gate": "tsx src/gate/cli.ts",
    "classify": "tsx src/classify/cli.ts",
    "plan": "tsx src/plan/cli.ts",
    "simplify": "tsx src/simplify/cli.ts",
    "review": "tsx src/review/cli.ts",
    "simplify-tool": "tsx src/tool/cli.ts",
    "pr-review": "tsx src/pr/cli.ts",
    "test": "vitest run tests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "github-pr-review": "tsx src/pr/githubCli.ts",
    "build": "tsc -p tsconfig.build.json",
    "service": "tsx src/service/cli.ts",
    "start": "node dist/service/cli.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.0",
    "tsx": "^4.20.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "typescript": "^5.8.0",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "main": "./dist/engine/index.js",
  "types": "./dist/engine/index.d.ts",
  "exports": {
    ".": "./dist/engine/index.js",
    "./execution": "./dist/execution/index.js",
    "./source": "./dist/source/index.js"
  }
}
